# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (resend.com/api-keys) ---
RESEND_API_KEY=
# While no domain is verified with Resend, use its test sender — it can only deliver
# to the email address of the Resend account owner. Swap once a real domain is verified.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Site ---
# Used to build the check-in URL encoded in each attendee's QR code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
